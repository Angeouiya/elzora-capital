DATABASE_URL="file:./db/custom.db"

# Collecte carte bancaire et Mobile Money via PayDunya.
# Laissez COLLECTIONS_ENABLED à false tant que les clés et le webhook n'ont
# pas été validés en environnement sandbox.
PAYMENT_PROVIDER_NAME="paydunya"
PAYDUNYA_MODE="sandbox"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
PUBLIC_APP_URL="https://example.com"
COLLECTIONS_ENABLED="false"

# Activer uniquement après validation du contrat de décaissement PayDunya.
# Les versements sortants exigent PAYDUNYA_MODE="live".
PAYOUTS_ENABLED="false"
