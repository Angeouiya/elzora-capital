{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elzora-capital",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elzora-capital-v2",
      "database_id": "584cd850-c34b-4815-a8b0-149e4b806ecd",
      "migrations_dir": "prisma/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KYC_DOCUMENTS",
      "bucket_name": "elzora-capital-kyc-private",
      "jurisdiction": "eu"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
