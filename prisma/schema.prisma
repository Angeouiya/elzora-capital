// ============================================================================
// NEXORA CAPITAL — Schéma de données
// ============================================================================
// Modèle métier : entreprise existante soumet un dossier → analyse → offre
// publiée → souscriptions → décaissement → remboursement → répartition.
// Dette et actions distinguées. Comptabilité en entiers (centimes implicites).
// ============================================================================

generator client {
  provider               = "prisma-client"
  output                 = "../src/lib/generated/prisma"
  runtime                = "workerd"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// UTILISATEURS (portail principal)
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  phone              String?
  passwordHash       String
  firstName          String
  lastName           String
  birthDate          String?
  country            String // code pays (SN, CI, ...)
  language           String    @default("fr")
  consentMarketing   Boolean   @default(false)
  // KYC / vérification
  kycStatus          String    @default("incomplete") // incomplete, pending, review, verified, rejected, refresh
  kycSubmittedAt     DateTime?
  kycVerifiedAt      DateTime?
  kycRejectionReason String?
  // Sécurité
  twoFactorEnabled   Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships          CompanyMember[]
  sessions             UserSession[]
  notifications        Notification[]
  submittedProjects    Project[]              @relation("ProjectSubmitter")
  kycProfile           KycProfile?
  kycDocuments         KycDocument[]
  legalAcceptances     LegalAcceptance[]
  subscriptionEvidence SubscriptionEvidence[]
}

model LegalAcceptance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType String
  version      String
  acceptedAt   DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  @@unique([userId, documentType, version])
  @@index([userId, acceptedAt])
}

model KycProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityType        String
  identityNumberHash  String
  identityNumberLast4 String
  documentCountry     String
  expiresAt           String?
  residentialAddress  String
  city                String
  occupation          String
  sourceOfFunds       String
  politicallyExposed  Boolean   @default(false)
  actingForSelf       Boolean   @default(true)
  consentAt           DateTime
  reviewedAt          DateTime?
  reviewedBy          String?
  decidedBy           String?
  decisionReason      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model KycDocument {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  storageKey  String    @unique
  fileName    String
  contentType String
  size        Int
  checksum    String
  status      String    @default("active")
  uploadedAt  DateTime  @default(now())
  reviewedAt  DateTime?

  @@index([userId, status])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo   String
  ipAddress    String
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  revoked      Boolean  @default(false)
}

// ---------------------------------------------------------------------------
// ENTREPRISES (emprunteuses ET/OU investisseuses)
// ---------------------------------------------------------------------------

model Company {
  id                    String    @id @default(cuid())
  legalName             String
  tradeName             String?
  legalForm             String // SARL, SA, SAS, etc.
  country               String
  address               String
  registrationNo        String // RCCM ou équivalent
  taxId                 String?
  activity              String
  foundedYear           Int?
  // Vérification
  verificationStatus    String    @default("incomplete") // incomplete, pending, verified, rejected
  verifiedAt            DateTime?
  // Compte de paiement vérifié (compte professionnel)
  verifiedBankAccount   String?
  bankAccountVerifiedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  members         CompanyMember[]
  projects        Project[]
  equityIssuances EquityIssuance[]
  equityDividends EquityDividend[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String // legal_representative, finance_officer, accountant, project_manager
  mandate   String   @default("view") // view, submit, sign, manage
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
}

// ---------------------------------------------------------------------------
// PROJETS (dossiers soumis par les entreprises)
// ---------------------------------------------------------------------------

model Project {
  id              String  @id @default(cuid())
  companyId       String
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy     String
  submitter       User    @relation("ProjectSubmitter", fields: [submittedBy], references: [id])
  title           String
  description     String
  longDescription String
  sector          String
  country         String
  city            String
  imageUrl        String

  // Conditions financières proposées par l'entreprise
  instrumentType      String // "debt" | "equity"
  // Dette
  fundingGoal         BigInt // montant recherché
  companyContribution BigInt  @default(0) // apport propre
  annualRate          Float?
  ratePeriod          String? // "total" | "annual"
  durationMonths      Int?
  repaymentType       String? // "bullet" | "amortized"
  gracePeriodMonths   Int? // différé
  // Actions
  equityOfferedPct    Float?
  valuationPre        BigInt?
  minInvestment       BigInt
  maxInvestment       BigInt?
  // Budget & calendrier
  budgetDetail        String?
  repaymentSource     String?
  risksIdentified     String?

  // Workflow d'analyse
  status          String    @default("draft")
  // draft, submitted, under_review, complement_requested, rejected,
  // approved, offer_prepared, offer_confirmed, published, funding,
  // funded, repaying, completed, defaulted, closed
  submittedAt     DateTime?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  fundedAt        DateTime?
  closedAt        DateTime?
  rejectionReason String?
  analysisNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer           Offer?
  investments     Investment[]
  payments        CompanyPayment[]
  documents       ProjectDocument[]
  timeline        ProjectEvent[]
  disbursements   Disbursement[]
  equityIssuance  EquityIssuance?
  equityDividends EquityDividend[]
}

model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // bilan, compte_resultat, business_plan, contrat, garantie, etc.
  fileName   String
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model ProjectEvent {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType   String // submitted, complement_requested, approved, published, funded, etc.
  description String
  actor       String // "system" | userId | "admin"
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// OFFRE (version publiée, distincte du dossier de travail)
// ---------------------------------------------------------------------------

model Offer {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version              Int      @default(1)
  // Conditions finales figées
  fundingGoal          BigInt
  minInvestment        BigInt
  maxInvestment        BigInt?
  annualRate           Float?
  ratePeriod           String?
  durationMonths       Int?
  repaymentType        String?
  equityOfferedPct     Float?
  valuationPre         BigInt?
  // Commission plateforme (figée contractuellement)
  upfrontCommissionPct Float    @default(6)
  annualFollowUpPct    Float    @default(2)
  // Collecte
  raisedAmount         BigInt   @default(0)
  committedAmount      BigInt   @default(0) // engagements (non confirmés)
  backersCount         Int      @default(0)
  // Dates
  publishedAt          DateTime @default(now())
  closingDate          DateTime
  // Visibilité
  visibility           String   @default("public") // public, restricted, whitelist
  status               String   @default("open") // open, closing, funded, failed, closed
  createdAt            DateTime @default(now())

  investments          Investment[]
  subscriptionEvidence SubscriptionEvidence[]
  equityIssuance       EquityIssuance?
}

// ---------------------------------------------------------------------------
// SOUSCRIPTIONS / INVESTISSEMENTS
// ---------------------------------------------------------------------------

model Investment {
  id                   String                     @id @default(cuid())
  offerId              String
  offer                Offer                      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  projectId            String
  project              Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Investisseur : particulier ou entreprise (relation polymorphique, pas de FK)
  investorType         String // "individual" | "company"
  investorId           String // userId ou companyId (stocké, pas de FK contrainte)
  investorName         String
  investorEmail        String
  amount               BigInt // montant investi
  sharePct             Float // part de l'offre (dette) ou de l'entreprise (capital)
  // État
  status               String                     @default("pending_payment")
  // pending_payment, payment_pending, confirmed, rejected, refunded, cancelled
  // Signature
  signedAt             DateTime?
  signatureHash        String?
  // Paiement
  paymentRef           String? // référence unique
  paymentConfirmedAt   DateTime?
  paymentEventId       String?                    @unique // verrou d'idempotence du webhook
  // Délai de rétractation
  reflectionEndsAt     DateTime?
  refundableUntil      DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  subscriptionEvidence SubscriptionEvidence?
  equityAllocation     EquityAllocation?
  equityDividends      EquityDividendAllocation[]

  @@index([investorId])
  @@index([offerId])
}

model SubscriptionEvidence {
  id                String     @id @default(cuid())
  investmentId      String     @unique
  investment        Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  offerId           String
  offer             Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  investorId        String
  investor          User       @relation(fields: [investorId], references: [id], onDelete: Cascade)
  offerVersion      Int
  agreementVersion  String
  termsVersion      String
  riskVersion       String
  agreementSnapshot String
  agreementHash     String
  signedPayloadHash String     @unique
  signatureMethod   String     @default("authenticated_clickwrap")
  locale            String     @default("fr")
  termsAcceptedAt   DateTime
  riskAcceptedAt    DateTime
  signedAt          DateTime
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime   @default(now())

  @@index([investorId, signedAt])
  @@index([offerId])
}

model EquityIssuance {
  id                     String             @id @default(cuid())
  offerId                String             @unique
  offer                  Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  projectId              String             @unique
  project                Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shareClass             String             @default("ordinary")
  totalOwnershipMicroPct BigInt
  status                 String             @default("pending_documents")
  resolutionRef          String?
  resolutionDate         String?
  declarationRef         String?
  shareRegisterRef       String?
  preparedBy             String?
  approvedBy             String?
  preparedAt             DateTime?
  approvedAt             DateTime?
  issuedAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  allocations            EquityAllocation[]
  dividends              EquityDividend[]

  @@index([companyId, status])
}

model EquityAllocation {
  id                String                     @id @default(cuid())
  issuanceId        String
  issuance          EquityIssuance             @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  investmentId      String                     @unique
  investment        Investment                 @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investorType      String
  investorId        String
  ownershipMicroPct BigInt
  status            String                     @default("pending_issuance")
  certificateNo     String?                    @unique
  issuedAt          DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  dividends         EquityDividendAllocation[]

  @@index([investorId, status])
  @@index([issuanceId])
}

model EquityDividend {
  id                  String                     @id @default(cuid())
  issuanceId          String
  issuance            EquityIssuance             @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  projectId           String
  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyId           String
  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  totalDeclaredAmount BigInt
  platformGrossAmount BigInt
  withholdingAmount   BigInt                     @default(0)
  netPayableAmount    BigInt
  currency            String                     @default("XOF")
  recordDate          String
  resolutionRef       String
  resolutionDate      String
  taxReference        String?
  rejectionReason     String?
  status              String                     @default("submitted")
  submittedBy         String
  reviewedBy          String?
  approvedBy          String?
  reviewedAt          DateTime?
  approvedAt          DateTime?
  paymentRef          String?                    @unique
  paymentEventId      String?                    @unique
  paidAt              DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  allocations         EquityDividendAllocation[]

  @@unique([issuanceId, resolutionRef])
  @@index([companyId, status])
  @@index([projectId, createdAt])
}

model EquityDividendAllocation {
  id                 String           @id @default(cuid())
  dividendId         String
  dividend           EquityDividend   @relation(fields: [dividendId], references: [id], onDelete: Cascade)
  equityAllocationId String
  equityAllocation   EquityAllocation @relation(fields: [equityAllocationId], references: [id], onDelete: Restrict)
  investmentId       String
  investment         Investment       @relation(fields: [investmentId], references: [id], onDelete: Restrict)
  investorType       String
  investorId         String
  ownershipMicroPct  BigInt
  grossAmount        BigInt
  withholdingAmount  BigInt           @default(0)
  netAmount          BigInt
  status             String           @default("pending")
  availableAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([dividendId, equityAllocationId])
  @@index([investorId, status])
  @@index([investmentId])
}

// ---------------------------------------------------------------------------
// PAIEMENTS ENTREPRISE (remboursement échéances)
// ---------------------------------------------------------------------------

model CompanyPayment {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installmentNo  Int
  dueDate        DateTime
  capitalDue     BigInt
  interestDue    BigInt
  followUpFeeDue BigInt    @default(0)
  totalDue       BigInt
  // État
  status         String    @default("upcoming")
  // upcoming, due, verifying, paid, partial, late, defaulted
  paidAt         DateTime?
  paidAmount     BigInt    @default(0)
  remaining      BigInt    @default(0)
  paymentRef     String?
  paymentEventId String?   @unique
  createdAt      DateTime  @default(now())

  distributions Distribution[]
}

// ---------------------------------------------------------------------------
// RÉPARTITIONS AUX INVESTISSEURS
// ---------------------------------------------------------------------------

model Distribution {
  id               String         @id @default(cuid())
  companyPaymentId String
  companyPayment   CompanyPayment @relation(fields: [companyPaymentId], references: [id], onDelete: Cascade)
  investmentId     String
  amount           BigInt // montant reçu par l'investisseur
  capitalPortion   BigInt
  interestPortion  BigInt
  feePortion       BigInt         @default(0)
  status           String         @default("pending")
  // pending, available, withdrawal_requested, withdrawn
  createdAt        DateTime       @default(now())
  availableAt      DateTime?

  @@unique([companyPaymentId, investmentId])
}

model Payout {
  id                 String    @id @default(cuid())
  investorType       String // "individual" | "company"
  investorId         String
  amount             BigInt
  fees               BigInt    @default(0)
  netAmount          BigInt
  status             String    @default("pending")
  // pending, ordered, completed, failed, uncertain
  beneficiaryAccount String // compte vérifié
  withdrawMode       String?
  partnerRef         String?
  providerEventId    String?   @unique
  failureReason      String?
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
}

// ---------------------------------------------------------------------------
// PORTAIL ADMINISTRATEUR (séparé, accès sur invitation)
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         String // superadmin, compliance, analyst, legal, technical, finance, validator, support, auditor, sales
  permissions  String // JSON string of permissions
  active       Boolean   @default(true)
  invitedAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  sessions AdminSession[]
}

model AdminSession {
  id           String    @id
  adminId      String
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  deviceInfo   String
  ipAddress    String
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revoked      Boolean   @default(false)

  @@index([adminId])
  @@index([lastActiveAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // "admin" | "user" | "system"
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   String // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // registration, verification, decision, publication, payment, etc.
  title     String
  message   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// GRAND LIVRE — Comptabilité en partie double (section 6)
// ---------------------------------------------------------------------------
// Chaque mouvement financier est tracé par 2 écritures au minimum (débit/crédit).
// Un solde affiché doit toujours pouvoir être reconcilié avec la somme des écritures.
// Comptes : investor_wallet, escrow (fonds reçus en attente), company_payout,
// platform_revenue (commissions), investor_external (fonds versés hors plateforme).

model LedgerEntry {
  id               String   @id @default(cuid())
  // Identifiant d'idempotence : un même idemKey ne peut produire qu'une seule écriture
  idemKey          String   @unique
  // Compte affecté
  accountType      String // investor_wallet, escrow, company_payout, platform_revenue, investor_external, company_external
  accountId        String // userId ou companyId ou offerId (selon accountType)
  // Contrepartie (pour audit)
  counterpartyType String?
  counterpartyId   String?
  // Montant en centimes (signé : + = crédit, - = débit sur ce compte)
  amount           BigInt
  // Devise
  currency         String   @default("XOF")
  // Liaison métier
  sourceType       String // investment, company_payment, distribution, payout, disbursement, commission
  sourceId         String
  // Description
  description      String
  createdAt        DateTime @default(now())

  @@index([accountType, accountId])
  @@index([sourceType, sourceId])
}

// ---------------------------------------------------------------------------
// DÉCAISSEMENT à l'entreprise (capital collecté - commissions)
// ---------------------------------------------------------------------------

model Disbursement {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grossAmount        BigInt // capital brut collecté
  upfrontCommission  BigInt
  netAmount          BigInt // montant net versé à l'entreprise
  beneficiaryAccount String
  trancheNo          Int       @default(1)
  status             String    @default("pending")
  preparedBy         String?
  approvedBy         String?
  executedAt         DateTime?
  paymentRef         String?
  createdAt          DateTime  @default(now())
}
